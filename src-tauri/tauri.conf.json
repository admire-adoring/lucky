{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucky-Y",
  "version": "0.1.0",
  "identifier": "com.lucky-y.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lucky-Y",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "Lucky-Y",
    "copyright": "Copyright © 2026 Lucky-Y",
    "shortDescription": "把生活、工作、学习装进同一个系统",
    "longDescription": "三域独立、执行统一。项目是唯一的执行层，用 scope 隔离归属；Markdown 为源、SQLite 为索引、Git 为同步，数据永远在你自己手里。"
  }
}
