<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
    /* ============================================================
       主题
       ============================================================ */
    const root = document.documentElement;
    const themeToggle = document.getElementById('themeToggle');

    function applyTheme(dark) {
        root.classList.toggle('dark', dark);
        themeToggle.textContent = dark ? '☀️' : '🌙';
        themeToggle.setAttribute('aria-pressed', String(dark));
        themeToggle.setAttribute('aria-label', dark ? '切换到浅色主题' : '切换到深色主题');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
    }
    applyTheme((localStorage.getItem('theme') || 'light') === 'dark');
    themeToggle.addEventListener('click', () => applyTheme(!root.classList.contains('dark')));

    /* ============================================================
       Toast
       ============================================================ */
    const TOAST_ICON = { ok: '✓', info: 'ℹ', warn: '⚠' };
    let toastTimer;

    function toast(msg, type = 'ok') {
        const t = document.getElementById('toast');
        t.dataset.type = type;
        t.innerHTML = '';
        const ico = document.createElement('span');
        ico.className = 'toast-ico';
        ico.setAttribute('aria-hidden', 'true');
        ico.textContent = TOAST_ICON[type] || TOAST_ICON.ok;
        const txt = document.createElement('span');
        txt.textContent = msg;
        t.append(ico, txt);
        t.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => t.classList.remove('show'), 2400);
    }

    /* ============================================================
       日志：在新窗口打开
       —— window.open 必须由用户手势直接触发，所以挂在 <a> 的 onclick 上；
          返回 false 阻止本页跳转；被浏览器拦截时返回 true，走链接默认行为（渐进增强）
       ============================================================ */
    const LOG_WINDOW_NAME = 'ops-log-window';

    function openLogWindow(a) {
        const url = a.getAttribute('href') + '#win';
        const w = window.open(url, LOG_WINDOW_NAME,
            'width=1320,height=920,left=80,top=60,resizable=yes,scrollbars=yes');
        if (w && !w.closed) {
            w.focus();
            toast('日志已在独立窗口打开');
            return false;
        }
        return true;
    }

    /* 部署面板：同样开独立窗口 —— 上传文件 + 执行启动命令期间要一直盯着，
       被运维页挡在后面就没意义了。窗口名固定，重复点只聚焦同一个窗口。 */
    const DEPLOY_WINDOW_NAME = 'ops-deploy-window';
    function openDeployWindow() {
        const url = '工作-项目-项目详情-运维-部署-index.html#win';
        const w = window.open(url, DEPLOY_WINDOW_NAME,
            'width=1320,height=920,left=120,top=80,resizable=yes,scrollbars=yes');
        if (w && !w.closed) {
            w.focus();
            toast('部署面板已在独立窗口打开');
            return false;
        }
        // 被弹窗拦截时退回本页打开，避免点了没反应
        location.href = url;
        return false;
    }

    /* ============================================================
       卡片折叠 —— grid-template-rows 0fr/1fr
       ============================================================ */
    function toggleOpsCard(cardId) {
        const card = document.getElementById(cardId);
        const collapsed = card.classList.toggle('collapsed');
        const head = card.querySelector('.ops-card-head');
        if (head) head.setAttribute('aria-expanded', String(!collapsed));
        if (collapsed) closeDetails(card);
    }

    /* ============================================================
       详情面板内的一排按钮组：同一面板内互斥切换
       ============================================================ */
    function switchServerTab(btn, tab) {
        const panel = btn.closest('.server-detail-panel');
        if (!panel) return;
        setServerTab(panel, tab);
    }

    function setServerTab(panel, tab) {
        panel.querySelectorAll('.sd-tab').forEach(t => {
            const on = t.dataset.tab === tab;
            t.classList.toggle('active', on);
            t.setAttribute('aria-selected', String(on));
        });
        panel.querySelectorAll('.sd-pane').forEach(p => p.classList.toggle('active', p.dataset.pane === tab));
    }

    /* 供「去看文件分布」这类跨区跳转使用 */
    function switchServerTabByName(panelId, tab) {
        const panel = document.getElementById(panelId);
        if (panel) setServerTab(panel, tab);
    }

    /* 收起面板时把分区复位到「信息」，保证每次展开都默认停在信息 */
    function resetServerTabs(panel) {
        setServerTab(panel, 'info');
    }

    /* ============================================================
       行内详情：同一容器内互斥展开
       ============================================================ */
    function closeDetails(scope) {
        scope.querySelectorAll('.server-detail-panel.open').forEach(p => {
            p.classList.remove('open');
            resetServerTabs(p);
        });
        scope.querySelectorAll('.deploy-detail-panel.open').forEach(p => p.classList.remove('open'));
        scope.querySelectorAll('.server-row.active').forEach(r => {
            r.classList.remove('active');
            r.setAttribute('aria-expanded', 'false');
        });
        scope.querySelectorAll('.deploy-row.expanded').forEach(r => {
            r.classList.remove('expanded');
            r.setAttribute('aria-expanded', 'false');
        });
    }

    function toggleServerDetail(row, detailId) {
        const detail = document.getElementById(detailId);
        const willOpen = !detail.classList.contains('open');
        closeDetails(document.getElementById('serverCard'));
        if (willOpen) {
            detail.classList.add('open');
            row.classList.add('active');
        }
        row.setAttribute('aria-expanded', String(willOpen));
    }

    function toggleDeployDetail(row, detailId) {
        const detail = document.getElementById(detailId);
        const willOpen = !detail.classList.contains('open');
        closeDetails(document.getElementById('deployCard'));
        if (willOpen) {
            detail.classList.add('open');
            row.classList.add('expanded');
        }
        row.setAttribute('aria-expanded', String(willOpen));
    }

    /* ============================================================
       发布记录筛选 + 空态
       ============================================================ */
    function filterDeploys(status, btn) {
        const chips = document.querySelectorAll('#deployChips .chip');
        chips.forEach(c => {
            const on = c === btn;
            c.classList.toggle('active', on);
            c.setAttribute('aria-pressed', String(on));
        });
        let shown = 0;
        document.querySelectorAll('#deployList .deploy-entry').forEach(entry => {
            const match = status === 'all' || entry.dataset.status === status;
            entry.hidden = !match;
            if (match) shown++;
        });
        document.getElementById('deployEmpty').hidden = shown > 0;
        document.getElementById('deployFilterInfo').textContent = shown + ' 条';
    }

    /* ============================================================
       刷新：骨架屏 → 数据回填
       ============================================================ */
    let refreshing = false;
    function refreshAll() {
        if (refreshing) return;
        refreshing = true;
        const list = document.getElementById('serverList');
        const skel = document.getElementById('serverSkeleton');
        list.hidden = true;
        skel.hidden = false;
        document.getElementById('lastSync').textContent = '正在同步…';

        setTimeout(() => {
            skel.hidden = true;
            list.hidden = false;
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('lastSync').textContent = `最后更新 ${hh}:${mm}`;
            refreshing = false;
            toast('监控数据已刷新');
        }, 900);
    }

    /* ============================================================
       二次确认弹窗 —— 破坏性操作不再"一键成功"
       ============================================================ */
    const mask = document.getElementById('modalMask');
    const mTitle = document.getElementById('modalTitle');
    const mBody = document.getElementById('modalBody');
    const mConfirm = document.getElementById('modalConfirm');
    let lastFocused = null;

    function openConfirm({ title, desc, warn, warnKind = 'danger', confirmText = '确定', danger = false, onConfirm }) {
        lastFocused = document.activeElement;
        mTitle.textContent = title;
        mBody.innerHTML = '';

        if (desc) {
            const p = document.createElement('p');
            p.textContent = desc;
            mBody.appendChild(p);
        }

        if (warn) {
            const box = document.createElement('div');
            box.className = 'modal-warn' + (warnKind === 'info' ? ' info' : '');
            box.setAttribute('role', 'note');
            const strong = document.createElement('strong');
            strong.textContent = warnKind === 'info' ? '说明：' : '影响：';
            const span = document.createElement('span');
            span.textContent = warn;
            box.append(strong, span);
            mBody.appendChild(box);
        }

        mConfirm.textContent = confirmText;
        mConfirm.className = 'btn ' + (danger ? 'btn-danger' : 'btn-primary');
        mConfirm.onclick = () => {
            closeModal();
            if (onConfirm) onConfirm();
        };

        mask.classList.add('open');
        mConfirm.focus();
    }

    function closeModal() {
        if (!mask.classList.contains('open')) return;
        mask.classList.remove('open');
        if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    mask.addEventListener('click', e => { if (e.target === mask) closeModal(); });

    function askRestart(name) {
        openConfirm({
            title: `重启 ${name}？`,
            desc: '重启会中断该服务器上正在处理的请求，通常在 20–40 秒内恢复。',
            warn: '若该节点正在承接线上流量，用户会看到短暂 502。建议先确认另一节点健康、或等业务低峰期执行。',
            confirmText: '确认重启',
            danger: true,
            onConfirm: () => toast(`已下发重启指令：${name}`, 'warn')
        });
    }

    function askRollback(version) {
        openConfirm({
            title: `回滚到 ${version}？`,
            desc: `将 prod-web-01 上的应用版本切回 ${version}，回滚过程自动执行，无需重新构建。`,
            warn: '回滚后，当前版本的数据写入与接口变更不会自动撤销。若涉及数据库结构变更，需人工处理。',
            confirmText: '确认回滚',
            danger: true,
            onConfirm: () => toast(`已回滚到 ${version}`, 'warn')
        });
    }

    function askCleanup(name) {
        openConfirm({
            title: `清理 ${name} 的磁盘？`,
            desc: '将清理 WAL 归档（7.8 G）与 14 天前的历史日志（4.2 G），预计释放约 12 G。',
            warn: '清理后的 WAL 归档无法用于时间点恢复。若仍需要该时间区间的恢复能力，请先完成一次全量备份。',
            confirmText: '确认清理',
            danger: true,
            onConfirm: () => toast('已开始清理，预计 3 分钟完成', 'warn')
        });
    }

    /* ============================================================
       键盘可达性：所有 role="button" 支持 Enter / Space
       ============================================================ */
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            if (mask.classList.contains('open')) { closeModal(); return; }
            closeDrawer();
            return;
        }
        if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('[role="button"]')) {
            e.preventDefault();
            e.target.click();
        }
    });

    /* 弹窗内 Tab 焦点循环 */
    mask.addEventListener('keydown', e => {
        if (e.key !== 'Tab') return;
        const focusables = mask.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    /* ============================================================
       移动端抽屉导航
       ============================================================ */
    const hamburger = document.getElementById('hamburger');

    function openDrawer() {
        document.body.classList.add('drawer-open');
        hamburger.setAttribute('aria-expanded', 'true');
    }
    function closeDrawer() {
        if (!document.body.classList.contains('drawer-open')) return;
        document.body.classList.remove('drawer-open');
        hamburger.setAttribute('aria-expanded', 'false');
    }
    hamburger.addEventListener('click', () => {
        document.body.classList.contains('drawer-open') ? closeDrawer() : openDrawer();
    });
    document.getElementById('sidebar').addEventListener('click', e => {
        if (e.target.closest('.menu-item')) closeDrawer();
    });

    /* ============================================================
       初始化
       ============================================================ */
    // 环境告警浮层：每个会话只提示一次，避免反复打扰
    if (!sessionStorage.getItem('ops-alert-shown')) {
        sessionStorage.setItem('ops-alert-shown', '1');
        setTimeout(() => toast('prod-db-01 磁盘使用率 95%，建议清理', 'warn'), 600);
    }
</script>
</body>
</html>
