                <div class="timesheet-row">
                    <span>用户中心改版</span>
                    <span class="timesheet-value">8h</span>
                </div>
                <div class="timesheet-row">
                    <span>数据看板</span>
                    <span class="timesheet-value">5h</span>
                </div>
                <div class="timesheet-row">
                    <span>会议</span>
                    <span class="timesheet-value">3h</span>
                </div>
                <div class="timesheet-row">
                    <span>代码评审</span>
                    <span class="timesheet-value">2h</span>
                </div>
            </section>
        </div>

        <!-- 周报复盘 -->
        <div class="panel" data-panel="review">
            <section class="card">
                <div class="review-block">
                    <div class="review-label">本周完成</div>
                    <ul class="review-list">
                        <li>完成支付系统重构方案评审</li>
                        <li>修复登录页样式问题</li>
                        <li>完成 3 次代码评审</li>
                        <li>更新接口设计规范</li>
                    </ul>
                </div>
                <div class="review-block">
                    <div class="review-label">下周计划</div>
                    <ul class="review-list">
                        <li>支付系统核心链路重构</li>
                        <li>用户中心改版接口联调</li>
                        <li>数据看板验收</li>
                    </ul>
                </div>
                <div class="review-block">
                    <div class="review-label">问题与阻塞</div>
                    <ul class="review-list">
                        <li>支付系统依赖第三方接口，联调延迟</li>
                        <li>用户中心改版需求有变更</li>
                    </ul>
                </div>
                <div class="review-block">
                    <div class="review-label">经验沉淀</div>
                    <ul class="review-list">
                        <li>重构前先做接口梳理，减少返工</li>
                        <li>代码评审提前介入，效果更好</li>
                    </ul>
                </div>
            </section>
        </div>

    </main>
</div>

<!-- 弹窗 -->
<div class="modal-mask" id="modalMask">
    <div class="modal">
        <div class="modal-head">
            <div class="modal-title" id="modalTitle">详情</div>
            <div class="modal-close" onclick="closeModal()">✕</div>
        </div>
        <div class="modal-body" id="modalBody"></div>
    </div>
</div>

<script>
    // ========== Tab 切换 ==========
    document.querySelectorAll('.tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const key = tab.dataset.tab;
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            document.querySelectorAll('.panel').forEach(p => {
                p.classList.toggle('active', p.dataset.panel === key);
            });
        });
    });

    // ========== 任务勾选 ==========
    document.querySelectorAll('.task-check').forEach(check => {
        check.addEventListener('click', (e) => {
            e.stopPropagation();
            check.classList.toggle('done');
            check.textContent = check.classList.contains('done') ? '✓' : '';
            const text = check.parentElement.querySelector('.task-text');
            if (text) text.classList.toggle('done');
        });
    });

    // ========== 快速记录 ==========
    document.getElementById('quickAdd').addEventListener('click', () => {
        alert('原型演示：快速记录');
    });

    // ========== 主题切换 ==========
    const themeToggle = document.getElementById('themeToggle');
    const savedTheme = localStorage.getItem('theme') || 'light';
    if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
        themeToggle.textContent = '☀️';
    }
    themeToggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        themeToggle.textContent = isDark ? '☀️' : '🌙';
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    // ========== 弹窗 ==========
    const modalMask = document.getElementById('modalMask');
    const modalTitle = document.getElementById('modalTitle');
    const modalBody = document.getElementById('modalBody');

    function openModal(title, html) {
        modalTitle.textContent = title;
        modalBody.innerHTML = html;
        modalMask.classList.add('open');
    }
    function closeModal() {
        modalMask.classList.remove('open');
    }
    modalMask.addEventListener('click', (e) => {
        if (e.target === modalMask) closeModal();
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
    });

    // ========== 客户资料详情 ==========
    function openClient(name) {
        const data = {
            '星辰科技': {
                avatar: '星',
                meta: '32 个文件 · 最近更新 2 小时前',
                contact: '张总 · CTO',
                projects: ['支付系统重构', '用户中心改版'],
                files: [
                    { icon: '📊', name: '需求清单 v3.xlsx', meta: 'Excel · 2 小时前 · 1.2 MB', tag: '需求' },
                    { icon: '📄', name: '接口说明.md', meta: 'MD · 昨天 · 24 KB', tag: '需求' },
                    { icon: '📕', name: '支付流程.pdf', meta: 'PDF · 3 天前 · 2.1 MB', tag: '参考' },
                    { icon: '🖼️', name: '原型图.png', meta: '图片 · 5 天前 · 1.4 MB', tag: '原型' }
                ],
                versions: [
                    '需求清单 v3.xlsx · 2026-09-20',
                    '需求清单 v2.xlsx · 2026-09-15',
                    '需求清单 v1.xlsx · 2026-09-10'
                ],
                notes: [
                    '需求以 v3 为准，v1/v2 已废弃',
                    '接口说明待确认鉴权方式'
                ]
            },
            '云启网络': {
                avatar: '云',
                meta: '18 个文件 · 最近更新 昨天',
                contact: '王总 · CEO',
                projects: ['用户中心改版'],
                files: [
                    { icon: '📄', name: '接口说明.md', meta: 'MD · 昨天 · 24 KB', tag: '需求' },
                    { icon: '📊', name: '字段对照表.xlsx', meta: 'Excel · 3 天前 · 320 KB', tag: '数据' },
                    { icon: '📕', name: '参考方案.pdf', meta: 'PDF · 5 天前 · 1.8 MB', tag: '参考' }
                ],
                versions: [],
                notes: ['接口鉴权方式待确认']
            },
            '蓝海数据': {
                avatar: '蓝',
                meta: '46 个文件 · 最近更新 3 天前',
                contact: '赵总 · 数据总监',
                projects: ['数据看板'],
                files: [
                    { icon: '📕', name: '数据字典.pdf', meta: 'PDF · 3 天前 · 3.4 MB', tag: '数据' },
                    { icon: '📊', name: '指标口径.xlsx', meta: 'Excel · 5 天前 · 680 KB', tag: '数据' },
                    { icon: '📄', name: '验收标准.md', meta: 'MD · 1 周前 · 12 KB', tag: '合同' }
                ],
                versions: [],
                notes: ['数据字典已确认，指标口径待复核']
            },
            '微光传媒': {
                avatar: '微',
                meta: '12 个文件 · 最近更新 5 天前',
                contact: '刘经理 · 市场',
                projects: [],
                files: [
                    { icon: '🖼️', name: '首页原型.png', meta: '图片 · 5 天前 · 860 KB', tag: '原型' },
                    { icon: '📄', name: '需求说明.md', meta: 'MD · 1 周前 · 18 KB', tag: '需求' }
                ],
                versions: [],
                notes: ['需求待进一步沟通']
            }
        };
        const d = data[name];
        if (!d) return;

        openModal(name + ' · 客户资料', `
      <div class="recipe-hero">${d.avatar}</div>

      <div class="detail-section">
        <div class="detail-label">客户信息</div>
        <div class="detail-row"><span>资料概况</span><span>${d.meta}</span></div>
        <div class="detail-row"><span>对接人</span><span>${d.contact}</span></div>
        <div class="detail-row"><span>关联项目</span><span>${d.projects.join(' / ') || '无'}</span></div>
      </div>

      <div class="detail-section">
        <div class="detail-label">资料文件</div>
        ${d.files.map(f => `
          <div class="doc-item">
            <div class="doc-icon">${f.icon}</div>
            <div class="doc-info">
              <div class="doc-name">${f.name}</div>
              <div class="doc-meta">${f.meta}</div>
            </div>
            <span class="client-tag">${f.tag}</span>
          </div>
        `).join('')}
      </div>

      ${d.versions.length ? `
      <div class="detail-section">
        <div class="detail-label">版本记录</div>
        <ul class="detail-list">
          ${d.versions.map(v => `<li>${v}</li>`).join('')}
        </ul>
      </div>` : ''}

      ${d.notes.length ? `
      <div class="detail-section">
        <div class="detail-label">备注</div>
        <ul class="detail-list">
          ${d.notes.map(n => `<li>${n}</li>`).join('')}
        </ul>
      </div>` : ''}

      <div class="form-actions">
        <button class="btn btn-ghost" onclick="closeModal()">关闭</button>
        <button class="btn btn-ghost" onclick="alert('原型演示：上传资料')">+ 上传资料</button>
        <button class="btn btn-primary" onclick="alert('原型演示：关联项目')">关联项目</button>
      </div>
    `);
    }
    // ========== 项目书架：飞出 / 飞回（版式演示） ==========
    // 只演示版式与动画时机 —— **弹窗正文不在这里**：应用按真实项目数据渲染，
    // 见 src/components/workspace/work/ProjectShelf.tsx。
    // ⚠️ 这一段刻意既不写 `function openXxx(`、也不在
    //    `getElementById(…).addEventListener('click', …)` 里调 openModal(…)：
    //    gen-workspace-pages.mjs 用这两条特征认「要迁移的弹窗」，认到了会往
    //    panels.tsx 里塞一个假的 —— 而这一块面板是手写的（见 MANUAL_PANELS）。
    (function () {
        const box = modalMask.querySelector('.modal');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let busy = false;
        let current = null;   // 当前打开的那本书：反向飞回要用它的矩形

        /** 克隆一本书，从 from 移到 to。`fadeOut` 为真 = 飞向弹窗（淡出），否则飞回书（淡入）。 */
        function spawn(book, from, to, fadeOut) {
            const clone = book.cloneNode(true);
            clone.classList.add('fly-clone');
            clone.style.transformOrigin = 'top left';
            clone.style.left = from.left + 'px';
            clone.style.top = from.top + 'px';
            clone.style.width = from.width + 'px';
            clone.style.height = from.height + 'px';
            clone.style.opacity = fadeOut ? '1' : '0.9';
            clone.style.borderRadius = fadeOut ? '3px 7px 7px 3px' : '20px';
            document.body.appendChild(clone);
            // 双 rAF：让"起点矩形"先真正上一帧。只等一帧的话，两条样式可能落在同一帧里，
            // 浏览器视为"没有变化"→ 克隆体瞬移而不是飞。
            requestAnimationFrame(() => requestAnimationFrame(() => {
                clone.classList.add('animating');
                clone.style.left = to.left + 'px';
                clone.style.top = to.top + 'px';
                clone.style.width = to.width + 'px';
                clone.style.height = to.height + 'px';
                clone.style.opacity = fadeOut ? '0' : '1';
                clone.style.borderRadius = fadeOut ? '20px' : '3px 7px 7px 3px';
            }));
            return clone;
        }

        function fill(book) {
            const progress = Number(book.dataset.progress || 0);
            const deadline = book.dataset.deadline || '—';
            const tone = book.dataset.tone || '#C13A4E';
            modalTitle.innerHTML =
                '<span class="modal-title-dot" style="background:' + tone + ';color:' + tone + ';"></span>' +
                (book.dataset.name || '');
            modalBody.innerHTML =
                '<div class="detail-section">' +
                    '<div class="detail-label">项目概况</div>' +
                    '<div class="detail-row"><span>截止日期</span><span>' + deadline + '</span></div>' +
                    '<div class="detail-row"><span>当前进度</span><span>' + progress + '%</span></div>' +
                '</div>' +
                '<div class="detail-section">' +
                    '<div class="detail-label">说明</div>' +
                    '<div class="notice">这份原型只演示<b>版式与动画时机</b>。弹窗正文（项目概况 / 项目描述 / 风险 / 关键节点 / 关联文档）由应用按<b>真实项目数据</b>渲染 —— 见 src/components/workspace/work/ProjectShelf.tsx。</div>' +
                '</div>' +
                '<div class="detail-section">' +
                    '<div class="progress-bar"><div class="progress-fill" style="width:' + progress + '%"></div></div>' +
                    '<div class="progress-label"><span>' + progress + '%</span><span>截止 ' + deadline + '</span></div>' +
                '</div>' +
                '<div class="form-actions"><button class="btn btn-ghost" onclick="closeShelf()">关闭</button></div>';
        }

        function showCard(book) {
            busy = true;
            current = book;
            fill(book);
            modalMask.classList.add('open');
            box.classList.remove('entering', 'leaving');
            if (reduced) {
                box.style.visibility = 'visible';
                busy = false;
                return;
            }
            // 先"占位但不可见"地量一次弹窗的最终矩形 —— 克隆体要飞向它
            box.style.visibility = 'hidden';
            const to = box.getBoundingClientRect();
            const clone = spawn(book, book.getBoundingClientRect(), to, true);
            setTimeout(() => { box.style.visibility = 'visible'; box.classList.add('entering'); }, 260);
            setTimeout(() => { clone.remove(); busy = false; }, 520);
        }

        /** 关闭（带反向飞出）。弹窗里那颗「关闭」按钮与遮罩/ESC 都走它。 */
        function closeShelf() {
            if (!current) { closeModal(); return; }
            const book = current;
            current = null;
            box.classList.remove('entering');
            if (reduced) { box.classList.remove('leaving'); closeModal(); return; }
            busy = true;
            box.classList.add('leaving');
            const clone = spawn(book, box.getBoundingClientRect(), book.getBoundingClientRect(), false);
            setTimeout(() => {
                clone.remove();
                closeModal();
                box.classList.remove('leaving');
                busy = false;
            }, 480);
        }
        window.closeShelf = closeShelf;

        document.addEventListener('click', (e) => {
            const book = e.target.closest('.book-flat');
            if (!book || busy) return;
            showCard(book);
        });
        /* 原型原有的"点遮罩 / ESC 关闭"只会 remove('open')，于是反向飞出不会发生。
           这两条在**捕获阶段**截住它们（捕获先于冒泡，stopPropagation 之后原来的监听收不到）。 */
        document.addEventListener('click', (e) => {
            if (!current || e.target !== modalMask) return;
            e.stopPropagation();
            closeShelf();
        }, true);
        document.addEventListener('keydown', (e) => {
            if (!current || e.key !== 'Escape') return;
            e.stopPropagation();
            closeShelf();
        }, true);
    })();
</script>
</body>
</html>